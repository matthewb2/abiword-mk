cmake_minimum_required(VERSION 3.16)

project(AbiWord LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

#
# Windows + MinGW platform defines
#

add_compile_definitions(

    _WIN32
    WIN32
    UNICODE
    _UNICODE

    WINVER=0x0601
    _WIN32_WINNT=0x0601

    ABIWORD_TARGET_WIN32
    TOOLKIT_WIN
    XP_WIN
    UT_PLATFORM_WIN32

    UT_COMPILER_GCC
    HAVE_GCC_INLINE_ASM

    HAVE_STDINT_H
    HAVE_STRING_H
)

#
# config.h
#

configure_file(
    ${CMAKE_SOURCE_DIR}/config.h.in
    ${CMAKE_BINARY_DIR}/config.h
)

include_directories(${CMAKE_BINARY_DIR})

#
# AbiWord include paths
#

include_directories(

    src

    src/af
    src/af/util
    src/af/util/xp
    src/af/util/win

    src/af/ev
    src/af/ev/xp
    src/af/ev/win

    src/af/gr
    src/af/gr/xp
    src/af/gr/win

    src/af/xap
    src/af/xap/xp
    src/af/xap/win

    src/af/tf
    src/af/tf/xp

    src/wp
    src/wp/ap
    src/wp/ap/xp
    src/wp/ap/win

    src/wp/main
    src/wp/main/xp
    src/wp/main/win

    src/wp/impexp
    src/wp/impexp/xp

    src/text
    src/text/fmt
    src/text/fmt/xp
    src/text/ptbl
    src/text/ptbl/xp
)

#
# Dependencies (MSYS2)
#

find_package(PkgConfig REQUIRED)

pkg_check_modules(GLIB REQUIRED glib-2.0)
pkg_check_modules(FRIBIDI REQUIRED fribidi)
pkg_check_modules(LIBXML2 REQUIRED libxml-2.0)
pkg_check_modules(GSF REQUIRED libgsf-1)

include_directories(
    ${GLIB_INCLUDE_DIRS}
    ${FRIBIDI_INCLUDE_DIRS}
    ${LIBXML2_INCLUDE_DIRS}
    ${GSF_INCLUDE_DIRS}
)

link_directories(
    ${GLIB_LIBRARY_DIRS}
    ${FRIBIDI_LIBRARY_DIRS}
    ${LIBXML2_LIBRARY_DIRS}
    ${GSF_LIBRARY_DIRS}
)

#
# Compile flags from pkg-config
#

add_compile_options(
    ${GLIB_CFLAGS_OTHER}
    ${FRIBIDI_CFLAGS_OTHER}
    ${LIBXML2_CFLAGS_OTHER}
    ${GSF_CFLAGS_OTHER}
)

#
# Source files
#

file(GLOB_RECURSE ABIWORD_SRC

    src/af/util/xp/*.cpp
    src/af/util/win/*.cpp

    src/af/ev/xp/*.cpp
    src/af/ev/win/*.cpp

    src/af/gr/xp/*.cpp
    src/af/gr/win/*.cpp

    src/af/xap/xp/*.cpp
    src/af/xap/win/*.cpp

    src/af/tf/xp/*.cpp

    src/wp/ap/xp/*.cpp
    src/wp/ap/win/*.cpp

    src/wp/main/xp/*.cpp
    src/wp/main/win/*.cpp

    src/wp/impexp/xp/*.cpp

    src/text/fmt/xp/*.cpp
    src/text/ptbl/xp/*.cpp
)

#
# Executable
#

add_executable(abiword WIN32
    ${ABIWORD_SRC}
)

#
# Force config.h include
#

target_compile_options(abiword PRIVATE
    -include ${CMAKE_BINARY_DIR}/config.h
)

#
# Link libraries
#

target_link_libraries(abiword

    ${GLIB_LIBRARIES}
    ${FRIBIDI_LIBRARIES}
    ${LIBXML2_LIBRARIES}
    ${GSF_LIBRARIES}

    gdi32
    user32
    comdlg32
    shell32
    ole32
    oleaut32
    uuid
    winspool
)

#
# warnings
#

target_compile_options(abiword PRIVATE
    -Wall
)

#
# install
#

install(TARGETS abiword
    RUNTIME DESTINATION bin
)