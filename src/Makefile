install-frameworksLTLIBRARIES: $(frameworks_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(frameworks_LTLIBRARIES)'; test -n "$(frameworksdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(frameworksdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(frameworksdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(frameworksdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(frameworksdir)"; \
	}

uninstall-frameworksLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(frameworks_LTLIBRARIES)'; test -n "$(frameworksdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(frameworksdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(frameworksdir)/$$f"; \
	done

clean-frameworksLTLIBRARIES:
	-test -z "$(frameworks_LTLIBRARIES)" || rm -f $(frameworks_LTLIBRARIES)
	@list='$(frameworks_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

