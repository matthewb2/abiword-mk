	wp/main/gtk/$(DEPDIR)/$(am__dirstamp)
wp/main/win/abiword-Win32Main.$(OBJEXT): wp/main/win/$(am__dirstamp) \
	wp/main/win/$(DEPDIR)/$(am__dirstamp)

abiword$(EXEEXT): $(abiword_OBJECTS) $(abiword_DEPENDENCIES) $(EXTRA_abiword_DEPENDENCIES) 
	@rm -f abiword$(EXEEXT)
	$(AM_V_CXXLD)$(abiword_LINK) $(abiword_OBJECTS) $(abiword_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f wp/main/cocoa/*.$(OBJEXT)
	-rm -f wp/main/gtk/*.$(OBJEXT)
	-rm -f wp/main/gtk/*.lo
	-rm -f wp/main/win/*.$(OBJEXT)
	-rm -f wp/main/xp/*.$(OBJEXT)
	-rm -f wp/main/xp/*.lo

distclean-compile:
	-rm -f *.tab.c

